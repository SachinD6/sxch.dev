{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "sxch.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.sxch.dev",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
